{
  "name": "@svs/desktop",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "node scripts/e2e.mjs",
    "dist": "electron-builder --config electron-builder.yml",
    "dist:dir": "electron-builder --config electron-builder.yml --dir",
    "smoke:real": "vitest run --config vitest.smoke.config.mts src/main/smoke/real.smoke.ts",
    "smoke:slima": "vitest run --config vitest.smoke.config.mts src/main/smoke/slima.smoke.ts"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-slot": "1.5.0",
    "@svs/db": "workspace:*",
    "@svs/engine": "workspace:*",
    "@svs/media": "workspace:*",
    "@svs/providers": "workspace:*",
    "@svs/schema": "workspace:*",
    "@svs/slima": "workspace:*",
    "@svs/test-utils": "workspace:*",
    "@svs/workflows": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "zod": "4.6.6"
  },
  "main": "./out/main/index.js",
  "description": "Slima Video Studio 桌面應用",
  "author": "Slima",
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "ffmpeg-static": "5.3.0",
    "slima-mcp": "0.3.2"
  }
}
