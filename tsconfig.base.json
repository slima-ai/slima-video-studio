{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@svs/schema": ["./packages/schema/src/index.ts"],
      "@svs/db": ["./packages/db/src/index.ts"],
      "@svs/engine": ["./packages/engine/src/index.ts"],
      "@svs/providers": ["./packages/providers/src/index.ts"],
      "@svs/media": ["./packages/media/src/index.ts"],
      "@svs/slima": ["./packages/slima/src/index.ts"],
      "@svs/workflows": ["./packages/workflows/src/index.ts"],
      "@svs/test-utils": ["./packages/test-utils/src/index.ts"]
    }
  }
}
